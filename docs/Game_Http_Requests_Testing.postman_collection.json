{
  "info": {
    "name": "Game HTTP Requests Testing",
    "description": "Complete collection of HTTP endpoints for the College Adventure Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          },
          "response": []
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('token', response.token);",
                  "    console.log('Token saved:', response.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "User Management",
      "item": [
        {
          "name": "Get User Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/user/profile",
              "host": ["{{baseUrl}}"],
              "path": ["user", "profile"]
            }
          },
          "response": []
        },
        {
          "name": "Update User Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Updated Display Name\",\n  \"language\": \"en\",\n  \"cosmeticData\": {\n    \"avatar\": \"default\",\n    \"theme\": \"classic\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/profile/update",
              "host": ["{{baseUrl}}"],
              "path": ["user", "profile", "update"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Chess Game",
      "item": [
        {
          "name": "Get Chess Leaderboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/chess/leaderboard",
              "host": ["{{baseUrl}}"],
              "path": ["chess", "leaderboard"]
            }
          },
          "response": []
        },
        {
          "name": "Get Chess Match History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chess/history",
              "host": ["{{baseUrl}}"],
              "path": ["chess", "history"]
            }
          },
          "response": []
        },
        {
          "name": "Get Current Match Info",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chess/matchInfo",
              "host": ["{{baseUrl}}"],
              "path": ["chess", "matchInfo"]
            }
          },
          "response": []
        },
        {
          "name": "Get Match Replay",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/chess/replay/{{matchId}}",
              "host": ["{{baseUrl}}"],
              "path": ["chess", "replay", "{{matchId}}"],
              "variable": [
                {
                  "key": "matchId",
                  "value": "example-match-uuid",
                  "description": "UUID of the match to replay"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Chat System",
      "item": [
        {
          "name": "Get Chat Messages",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chat/general/messages",
              "host": ["{{baseUrl}}"],
              "path": ["chat", "general", "messages"]
            }
          },
          "response": []
        },
        {
          "name": "Post Chat Message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Hello from the cafeteria!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/chat/general/messages",
              "host": ["{{baseUrl}}"],
              "path": ["chat", "general", "messages"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "System",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            }
          },
          "response": []
        },
        {
          "name": "Get Server Time",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/time",
              "host": ["{{baseUrl}}"],
              "path": ["time"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
